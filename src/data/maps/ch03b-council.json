    {"id": "appointment", "when": {"all": [{"type": "flag", "name": "mashtub-won"}, {"type": "flag", "name": "harimi-won"}, {"type": "flag", "name": "qutb-won"}]}, "then": [{"type": "dialogue", "scene": "ch03.appointment"}, {"type": "promote", "unit": "salah-ad-din"}]}
